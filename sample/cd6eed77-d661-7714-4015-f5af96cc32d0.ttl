        "Doopdatum: 17-11-1731<br/><br/><a href=\"/collecties/archieven/archievenoverzicht/search/list/findingaid/132.1.10/file/4\">Inventarisnummer 4 van archiefnummer 132.1.10 in Archieven</a>"@nl ;
    sdo:locationCreated "Zevenhoven"@nl ;
    sdo:name "Erfgoed Leiden (Leiden), Archiefnaam: Doop-, trouw- en begraafregisters Zevenhoven, Deel: 4, Periode: 1682-1811, (toegangsnr. 132.1.10), inv.nr. 4, \"Doopboek, trouwboek en doodboek (RK) van Zevenhoven\", doopinschrijvingen, 11 maart 1682 - 1807 (fol. 5-153) met daaraan vooraf (fol. 1-4) een inschrijving van een abnormale geborene, 21 maart 1765, enkele inschrijvingen van gedoopten in Den Hoef, 1729 - 1743 en in 1753 vervaardigde kopie-inschrijvingen, 20 maart 1682 - 4 april 1684; trouwinschrijvingen 25 november 1697 - 30 juli 1751 (fol. 28-110) en aan de keerzijde, 21 maart 1753 - 21 oktober 1805 (fol. 1-7verso); namen van overledenen, 28 februari 1697 -18 oktober 1752 (fol. 27-111) een aan de keerzijde, 1753 - oktober 1811 (fol. 9-18 verso) met alfabetische index over het 1753 - 1811., 85v, "@nl ;
    sdo:url "https://www.erfgoedleiden.nl/collecties/personen/zoek-op-personen/deeds/cd6eed77-d661-7714-4015-f5af96cc32d0"^^xsd:anyURI .

