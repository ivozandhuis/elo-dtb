PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX picom: <https://personsincontext.org/model#>
PREFIX sdo: <https://schema.org/>
PREFIX picot_roles: <https://terms.personsincontext.org/roles/>
PREFIX ql: <http://qlever.cs.uni-freiburg.de/builtin-functions/>

CONSTRUCT {
	?bride picom:hasChild-in-law ?witness .
    ?witness sdo:gender sdo:Male .
}
WHERE {
    {
        ?text ql:contains-word "bruid schoonzoon" .
        ?text ql:contains-entity ?desc .
        FILTER(CONTAINS(LCASE(?desc), "relatie tot de bruid: schoonzoon")
            || CONTAINS(LCASE(?desc), "relatie tot de bruid: toekomstig schoonzoon"))
    } UNION {
        ?text ql:contains-word "bruid aanbehuwdzoon" .
        ?text ql:contains-entity ?desc .
        FILTER(CONTAINS(LCASE(?desc), "relatie tot de bruid: aanbehuwdzoon")
            || CONTAINS(LCASE(?desc), "relatie tot de bruid: toekomstig aanbehuwdzoon"))
    }
    ?witness a picom:PersonObservation ;
    	prov:hadPrimarySource ?src ;
    	sdo:description ?desc .
    ?bride a picom:PersonObservation ; 
    	prov:hadPrimarySource ?src ;
    	picom:hasRole picot_roles:574 ;
    	sdo:gender sdo:Female .
}
