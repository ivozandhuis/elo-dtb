PREFIX sdo: <https://schema.org/>
PREFIX picom: <https://personsincontext.org/model#>
PREFIX pnv: <https://w3id.org/pnv#>
PREFIX bloothooft: <https://linkeddata.cultureelerfgoed.nl/clariahnames/vocab/>

CONSTRUCT {
  ?po <https://ex.com/vocabulary/iz/bloothooftGivenName> ?gn_uri .
}
WHERE {
  {
    SELECT ?po (STR(?givenname) AS ?key) WHERE {
      ?po a picom:PersonObservation ;
          sdo:additionalName/pnv:givenName ?givenname .
    }
  }
  {
    SELECT ?gn_uri (STR(?gn_value) AS ?key) WHERE {
      ?gn_uri bloothooft:gn ?gn_value ;
	          bloothooft:gn_standard ?gn_standard ;
			  sdo:gender ?gender .
    }
  }
}