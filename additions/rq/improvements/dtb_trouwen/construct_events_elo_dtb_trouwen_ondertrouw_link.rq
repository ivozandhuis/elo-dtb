PREFIX sdo: <https://schema.org/>
PREFIX picom: <https://personsincontext.org/model#>
PREFIX picot_eventtypes: <https://terms.personsincontext.org/eventtypes/>
PREFIX picot_sourcetypes: <https://terms.personsincontext.org/sourcetypes/>
PREFIX picot_roles: <https://terms.personsincontext.org/roles/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX ql: <http://qlever.cs.uni-freiburg.de/builtin-functions/>

CONSTRUCT {
  ?party picom:hasLifeEvent ?event_uri .
}
WHERE {
  ?text ql:contains-word "ondertrouw" .
  ?text ql:contains-entity ?description .
  ?source a sdo:ArchiveComponent ;
          sdo:description ?description .
  FILTER (CONTAINS(?description, "Datum ondertrouw: "))
    ?party a picom:PersonObservation ; 
        prov:hadPrimarySource ?source ;
        picom:hasRole picot_roles:574 .
  BIND(IRI(CONCAT(STR(?source), "_ondertrouw_event")) AS ?event_uri)
}
