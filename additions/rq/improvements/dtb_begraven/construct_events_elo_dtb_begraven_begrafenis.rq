PREFIX sdo: <https://schema.org/>
PREFIX picom: <https://personsincontext.org/model#>
PREFIX picot_eventtypes: <https://terms.personsincontext.org/eventtypes/>
PREFIX picot_sourcetypes: <https://terms.personsincontext.org/sourcetypes/>
PREFIX picot_roles: <https://terms.personsincontext.org/roles/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX ql: <http://qlever.cs.uni-freiburg.de/builtin-functions/>

CONSTRUCT {
  ?event_uri a picom:LifeEvent ;
    picom:eventType picot_eventtypes:76 ;
    picom:eventPlace ?event_place ;
    picom:eventDate ?event_date .

    ?source sdo:dateCreated ?event_date ;
         sdo:additionalType picot_sourcetypes:526 .
}
WHERE {
  ?text ql:contains-word "begraven" .
  ?text ql:contains-entity ?description .
  ?source a sdo:ArchiveComponent ;
          sdo:locationCreated ?event_place ;
          sdo:description ?description .
  FILTER (CONTAINS(?description, "Datum begraven: "))
  BIND (replace(?description, ".*Datum begraven: (\\d\\d)-(\\d\\d)-(\\d\\d\\d\\d).*", "$3-$2-$1") AS ?event_date)
  BIND (IRI(CONCAT(STR(?source), "_begraaf_event")) AS ?event_uri)
}

