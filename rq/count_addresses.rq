PREFIX sdo: <https://schema.org/>
PREFIX picom: <https://personsincontext.org/model#>
PREFIX pnv: <https://w3id.org/pnv#>

SELECT ?address (COUNT(?address) AS ?addressCount) WHERE {
  ?po a picom:PersonObservation ;
      sdo:address ?residence .
  BIND(STR(?residence) AS ?address) # count language agnostic
} 
GROUP BY ?address
ORDER BY DESC(?addressCount)