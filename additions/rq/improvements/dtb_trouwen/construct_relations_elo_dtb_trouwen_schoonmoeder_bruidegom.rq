PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX picom: <https://personsincontext.org/model#>
PREFIX sdo: <https://schema.org/>
PREFIX picot_roles: <https://terms.personsincontext.org/roles/>
PREFIX ql: <http://qlever.cs.uni-freiburg.de/builtin-functions/>

CONSTRUCT {
	?groom picom:hasParent-in-law ?witness .
    ?witness sdo:gender sdo:Female .
}
WHERE {
    {
        ?text ql:contains-word "bruidegom schoonmoeder" .
        ?text ql:contains-entity ?desc .
        FILTER(CONTAINS(LCASE(?desc), "relatie tot de bruidegom: schoonmoeder")
            || CONTAINS(LCASE(?desc), "relatie tot de bruidegom: toekomstig schoonmoeder"))
    } UNION {
        ?text ql:contains-word "bruidegom aanbehuwdmoeder" .
        ?text ql:contains-entity ?desc .
        FILTER(CONTAINS(LCASE(?desc), "relatie tot de bruidegom: aanbehuwdmoeder")
            || CONTAINS(LCASE(?desc), "relatie tot de bruidegom: toekomstig aanbehuwdmoeder"))
    }
    ?witness a picom:PersonObservation ;
    	prov:hadPrimarySource ?src ;
    	sdo:description ?desc .
    ?groom a picom:PersonObservation ; 
    	prov:hadPrimarySource ?src ;
    	picom:hasRole picot_roles:574 ;
    	sdo:gender sdo:Male .
}
